<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- From API 31 the system exposes the wallpaper-derived palette as real
         colour resources, so the launcher icon and the splash can follow
         Material You without any code. -->
    <color name="ic_launcher_background">@android:color/system_neutral1_900</color>
    <color name="ic_launcher_foreground_tint">@android:color/system_accent1_200</color>
</resources>
