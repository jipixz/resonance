<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Resonance" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ic_launcher_background</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <!-- The system splash that shows before the first frame. Matching it to
             the window background is what stops the launch reading as a black
             flash followed by a coloured app. -->
        <item name="android:windowSplashScreenBackground">@color/ic_launcher_background</item>
    </style>
</resources>
