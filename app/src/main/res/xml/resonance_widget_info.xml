<?xml version="1.0" encoding="utf-8"?>
<!--
    targetCellWidth/Height are the Android 12+ way of stating a preferred size in
    launcher grid cells; minWidth/minHeight are the pre-12 fallback the picker
    still reads. Both are given so the widget lands at a sensible size on any
    launcher instead of at whatever the grid decides.

    resizeMode is horizontal|vertical because the layout genuinely answers for
    every shape in between — see ResonanceWidget's SizeMode.Exact, which
    recomposes at the real frame size on every resize rather than picking
    among a handful of pre-rendered ones.

    initialLayout is mandatory, not optional. Leaving it out left the system
    with no layout to show before Glance's first draw, which is what stopped the
    widget responding to taps or offering resize handles at all.

    maxResizeWidth/Height briefly matched SizeMode.Responsive's largest bucket
    exactly (250x180) to stop content floating in dead space past it — that
    left zero growth room in the width axis from the widget's own default
    size, and the launcher's answer to "nowhere left to grow" was to drop the
    resize handles entirely rather than still offering height. Moving to
    SizeMode.Exact removed the reason for the cap: there is no bucket to run
    out of any more, so these are back to generous values that just bound
    what a home-screen widget should reasonably span.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="60dp"
    android:minResizeWidth="140dp"
    android:minResizeHeight="60dp"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:maxResizeWidth="360dp"
    android:maxResizeHeight="280dp"
    android:updatePeriodMillis="0"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_description"
    android:previewLayout="@layout/widget_preview"
    android:initialLayout="@layout/widget_loading" />
